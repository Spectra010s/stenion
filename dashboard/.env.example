# Stenion dashboard configuration.
#
# Copy to .env.local (gitignored) for local dev:
#   cp .env.example .env.local

# Base URL of the Stenion API (@stenion/api). SERVER-ONLY — the dashboard reads
# the API from React Server Components, so this is NOT prefixed NEXT_PUBLIC_ and
# is never exposed to the browser. Default if unset: http://localhost:3001
#
# Local dev: run `pnpm --filter @stenion/api start` (defaults to :3001, set by
# root .env's API_PORT=3001). The dashboard itself runs on :3000, so the two
# never collide. Deployed: point this at the deployed API origin.
STENION_API_URL=http://localhost:3001
