# Stenion database configuration.
#
# The db package (and the indexer) load the nearest .env walking up from the
# current directory, so a single .env at the repo root works for everything;
# this file documents the one variable the storage layer needs. 

# Postgres connection string. Use the *pooled* connection string from your Neon
# project dashboard (Connection Details → "Pooled connection"). It already
# includes ?sslmode=require, which pg honours with normal cert verification
# (Neon's certificate is publicly valid — no extra SSL config needed).
#
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/stenion?sslmode=require
